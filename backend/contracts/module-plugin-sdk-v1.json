{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chatraw.local/contracts/module-plugin-sdk-v1.json",
  "contract": "ChatRaw Module Plugin SDK",
  "version": "1.5.0",
  "global": "window.ChatRaw.modules",
  "transport": {
    "origin": "same-origin",
    "authentication": "ChatRaw session",
    "plugin_calls_module_directly": false,
    "module_supplies_frontend_code": false
  },
  "methods": {
    "getFeatureStatus": {
      "arguments": [
        {
          "name": "moduleId",
          "type": "string",
          "required": true
        }
      ],
      "returns": "Promise<FeatureStatus>",
      "endpoint": "GET /api/module-features/{moduleId}"
    },
    "uploadTaskResource": {
      "arguments": [
        {
          "name": "file",
          "type": "File",
          "required": true
        }
      ],
      "returns": "Promise<TaskInputResource>",
      "endpoint": "POST /api/module-task-resources",
      "side_effect": "uploads a temporary task input resource; bind the returned resource_id through startTask.resource_ids within 24 hours"
    },
    "startTask": {
      "arguments": [
        {
          "name": "request",
          "type": "StartTaskRequest",
          "required": true
        },
        {
          "name": "options",
          "type": "StartTaskOptions",
          "required": false
        }
      ],
      "returns": "Promise<Task>",
      "endpoint": "POST /api/module-tasks",
      "side_effect": "presentation defaults to task_center, which opens the ChatRaw core task UI and subscribes; embedded registers the task without opening the task center and the caller subscribes explicitly; conversation requires chat_id and user_message, binds the task to the conversation, subscribes, and never opens the task center"
    },
    "listTasks": {
      "arguments": [
        {
          "name": "filters",
          "type": "TaskFilters",
          "required": false
        }
      ],
      "returns": "Promise<Task[]>",
      "endpoint": "GET /api/module-tasks"
    },
    "getTask": {
      "arguments": [
        {
          "name": "taskId",
          "type": "string",
          "required": true
        }
      ],
      "returns": "Promise<Task>",
      "endpoint": "GET /api/module-tasks/{taskId}"
    },
    "subscribe": {
      "arguments": [
        {
          "name": "taskId",
          "type": "string",
          "required": true
        },
        {
          "name": "listener",
          "type": "function | EventHandlers | null",
          "required": false
        }
      ],
      "returns": "UnsubscribeFunction",
      "endpoint": "GET /api/module-tasks/{taskId}/events",
      "recovery": "reconnects with Last-Event-ID and bounded backoff"
    },
    "cancelTask": {
      "arguments": [
        {
          "name": "taskId",
          "type": "string",
          "required": true
        }
      ],
      "returns": "Promise<Task>",
      "endpoint": "POST /api/module-tasks/{taskId}/cancel"
    },
    "respondApproval": {
      "arguments": [
        {
          "name": "taskId",
          "type": "string",
          "required": true
        },
        {
          "name": "approvalId",
          "type": "string",
          "required": true
        },
        {
          "name": "decision",
          "type": "approve | deny",
          "required": true
        }
      ],
      "returns": "Promise<Task>",
      "endpoint": "POST /api/module-tasks/{taskId}/approvals/{approvalId}"
    },
    "downloadArtifact": {
      "arguments": [
        {
          "name": "taskId",
          "type": "string",
          "required": true
        },
        {
          "name": "artifactRef",
          "type": "string",
          "required": true
        }
      ],
      "returns": "Promise<{filename: string}>",
      "endpoint": "GET /api/module-tasks/{taskId}/artifacts/{artifactRef}"
    },
    "getTaskResourceView": {
      "arguments": [
        {
          "name": "taskId",
          "type": "string",
          "required": true
        },
        {
          "name": "resourceRef",
          "type": "string",
          "required": true
        }
      ],
      "returns": "Promise<TaskResourceView>",
      "endpoint": "GET /api/module-tasks/{taskId}/resources/{resourceRef}?disposition=inline",
      "side_effect": "validates access and metadata before returning a same-origin session-protected content URL; the URL is not a bearer credential"
    },
    "downloadTaskResource": {
      "arguments": [
        {
          "name": "taskId",
          "type": "string",
          "required": true
        },
        {
          "name": "resourceRef",
          "type": "string",
          "required": true
        }
      ],
      "returns": "Promise<{filename: string}>",
      "endpoint": "GET /api/module-tasks/{taskId}/resources/{resourceRef}?disposition=attachment"
    }
  },
  "events": {
    "schema": "module-task-v1.schema.json#/$defs/event",
    "types": {
      "task.status": {
        "data": {
          "state": "PublicTaskState",
          "outcome_code": "string | absent"
        }
      },
      "task.progress": {
        "data": {
          "progress": "number 0..1",
          "message": "string | absent"
        }
      },
      "output.delta": {
        "data": {
          "text": "string"
        }
      },
      "output.snapshot": {
        "data": {
          "text": "string",
          "compacted_through": "integer | absent"
        }
      },
      "approval.requested": {
        "data": {
          "approval_id": "string",
          "prompt": "string",
          "expires_at": "RFC3339 timestamp"
        }
      },
      "approval.resolved": {
        "data": {
          "approval_id": "string",
          "decision": "approve | deny"
        }
      },
      "activity.updated": {
        "data": {
          "schema_version": "1",
          "run_id": "UUID",
          "activity_id": "UUID",
          "kind": "phase | plan | tool",
          "state": "started | updated | succeeded | failed | cancelled",
          "title": "safe user-visible string",
          "summary": "safe user-visible string | absent",
          "detail": "strict kind-specific activity snapshot"
        },
        "reducer": "upsert by run_id plus activity_id; the latest complete snapshot replaces the previous snapshot"
      },
      "artifact.added": {
        "data": "module artifact metadata; call getTask for the Server artifact_ref"
      },
      "task.terminal": {
        "data": {
          "state": "succeeded | failed | cancelled",
          "outcome_code": "string | absent"
        }
      }
    }
  },
  "errors": {
    "shape": {
      "name": "ModuleSdkError",
      "message": "safe public message",
      "code": "stable machine code",
      "status": "HTTP status or 0 for local validation"
    },
    "local_codes": [
      "invalid_sdk_argument",
      "module_request_failed",
      "module_event_stream_failed",
      "module_event_stream_incomplete",
      "artifact_download_failed",
      "task_resource_upload_failed",
      "task_resource_upload_response_invalid",
      "task_resource_view_failed",
      "task_resource_preview_unavailable",
      "task_resource_download_failed",
      "invalid_event_cursor"
    ],
    "common_server_codes": [
      "module_not_enabled",
      "module_not_ready",
      "module_review_required",
      "plugin_missing",
      "plugin_disabled",
      "plugin_incompatible",
      "resident_missing",
      "resident_incompatible",
      "module_action_not_found",
      "module_action_forbidden",
      "invalid_task_request",
      "task_not_found",
      "task_control_forbidden",
      "invalid_approval",
      "artifact_not_found",
      "artifact_expired",
      "resource_not_found",
      "resource_expired",
      "resource_already_bound",
      "task_resource_not_found",
      "task_resource_expired",
      "task_resource_forbidden"
    ],
    "passthrough": "When Server returns {detail, code}, the SDK preserves code and HTTP status."
  },
  "$defs": {
    "StartTaskRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "module_id",
        "action_id",
        "input"
      ],
      "properties": {
        "module_id": {
          "type": "string"
        },
        "action_id": {
          "type": "string"
        },
        "input": {
          "type": "object"
        },
        "chat_id": {
          "type": "string"
        },
        "user_message": {
          "type": "string"
        },
        "resource_ids": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "string"
          }
        },
        "active_skill_ids": {
          "type": "array",
          "maxItems": 5,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "idempotency_key": {
          "type": "string"
        }
      }
    },
    "StartTaskOptions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "presentation": {
          "enum": [
            "task_center",
            "embedded",
            "conversation"
          ],
          "default": "task_center"
        }
      }
    },
    "TaskFilters": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "module_id": {
          "type": "string",
          "minLength": 1
        },
        "action_id": {
          "type": "string",
          "minLength": 1
        },
        "state": {
          "type": "string",
          "minLength": 1
        },
        "chat_id": {
          "type": "string",
          "minLength": 1
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      }
    },
    "FeatureAction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action_id",
        "action_version",
        "minimum_role",
        "supports_stream",
        "supports_cancel",
        "supports_approval",
        "supports_artifacts",
        "supports_resources",
        "supports_skills",
        "supports_rules",
        "supports_chat_projection"
      ],
      "properties": {
        "action_id": {"type": "string"},
        "action_version": {"type": "string"},
        "minimum_role": {"enum": ["member", "admin"]},
        "supports_stream": {"type": "boolean"},
        "supports_cancel": {"type": "boolean"},
        "supports_approval": {"type": "boolean"},
        "supports_artifacts": {"type": "boolean"},
        "supports_resources": {"type": "boolean"},
        "supports_skills": {"type": "boolean"},
        "supports_rules": {"type": "boolean"},
        "supports_chat_projection": {"type": "boolean"}
      }
    },
    "FeatureStatus": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sdk_version",
        "module_id",
        "name",
        "module_version",
        "protocol_version",
        "visible",
        "available",
        "state",
        "reason",
        "frontend_integration",
        "companion_plugin",
        "actions"
      ],
      "properties": {
        "sdk_version": {
          "const": "1.5.0"
        },
        "module_id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "module_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "protocol_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "visible": {
          "type": "boolean"
        },
        "available": {
          "type": "boolean"
        },
        "state": {
          "enum": [
            "hidden",
            "available",
            "unavailable"
          ]
        },
        "reason": {
          "type": [
            "object",
            "null"
          ]
        },
        "companion_plugin": {
          "type": [
            "object",
            "null"
          ]
        },
        "frontend_integration": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "mode",
                "id",
                "required_version",
                "status"
              ],
              "properties": {
                "mode": {
                  "enum": [
                    "plugin",
                    "resident"
                  ]
                },
                "id": {
                  "type": "string"
                },
                "required_version": {
                  "type": "string"
                },
                "status": {
                  "type": "string"
                }
              }
            }
          ]
        },
        "actions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/FeatureAction"
          }
        }
      }
    },
    "TaskInputResource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resource_id",
        "filename",
        "media_type",
        "size",
        "sha256",
        "expires_at"
      ],
      "properties": {
        "resource_id": {"type": "string"},
        "filename": {"type": "string"},
        "media_type": {"type": "string"},
        "size": {"type": "integer", "minimum": 0},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "expires_at": {"type": "string", "format": "date-time"}
      }
    },
    "TaskOutputResource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resource_ref",
        "filename",
        "media_type",
        "size"
      ],
      "properties": {
        "resource_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "filename": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "not": {"pattern": "[/\\\\\\u0000-\\u001f\\u007f]"}
        },
        "media_type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 127
        },
        "size": {"type": "integer", "minimum": 0},
        "expires_at": {
          "oneOf": [
            {"type": "string", "format": "date-time"},
            {"type": "null"}
          ]
        }
      }
    },
    "Task": {
      "type": "object",
      "required": [
        "resources",
        "user_message_id",
        "assistant_message_id"
      ],
      "properties": {
        "user_message_id": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "assistant_message_id": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "resources": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "$ref": "#/$defs/TaskOutputResource"
          }
        }
      }
    },
    "TaskResourceView": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "url",
        "mime",
        "filename",
        "size",
        "disposition"
      ],
      "properties": {
        "url": {
          "type": "string",
          "description": "same-origin session-protected inline content URL"
        },
        "mime": {"type": "string"},
        "filename": {"type": "string"},
        "size": {"type": "integer", "minimum": 0},
        "disposition": {"const": "inline"}
      }
    },
    "SdkError": {
      "type": "object",
      "required": [
        "name",
        "message",
        "code",
        "status"
      ],
      "properties": {
        "name": {
          "const": "ModuleSdkError"
        },
        "message": {
          "type": "string"
        },
        "code": {
          "type": "string"
        },
        "status": {
          "type": "integer"
        }
      }
    }
  },
  "browser_persistence": {
    "key": "chatraw_module_tasks_v1",
    "allowed": [
      "task_id"
    ],
    "forbidden": [
      "module_address",
      "module_token",
      "artifact_path",
      "task_input",
      "task_output"
    ]
  },
  "compatibility": {
    "preserve_globals": [
      "window.ChatRawPlugin"
    ],
    "preserve_extension_points": [
      "hooks",
      "toolbar buttons",
      "plugin fullscreen modal"
    ]
  }
}
