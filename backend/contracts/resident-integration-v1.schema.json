{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chatraw.example/contracts/resident-integration-v1.schema.json",
  "title": "ChatRaw Resident Integration v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "version",
    "module_id",
    "name",
    "description",
    "minimum_role",
    "entrypoints",
    "required_actions",
    "main",
    "styles"
  ],
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "id": {
      "$ref": "#/$defs/integrationId"
    },
    "version": {
      "$ref": "#/$defs/semver"
    },
    "module_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$",
      "minLength": 3,
      "maxLength": 128
    },
    "name": {
      "$ref": "#/$defs/localizedText"
    },
    "description": {
      "$ref": "#/$defs/localizedText"
    },
    "minimum_role": {
      "enum": [
        "member",
        "admin"
      ]
    },
    "entrypoints": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "$ref": "#/$defs/entrypoint"
      }
    },
    "required_actions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "$ref": "#/$defs/requiredAction"
      }
    },
    "main": {
      "$ref": "#/$defs/sourceFile"
    },
    "styles": {
      "$ref": "#/$defs/sourceFile"
    }
  },
  "$defs": {
    "integrationId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "minLength": 3,
      "maxLength": 64
    },
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$",
      "maxLength": 64
    },
    "localizedText": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "en",
        "zh"
      ],
      "properties": {
        "en": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "zh": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        }
      }
    },
    "sourceFile": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$",
      "minLength": 3,
      "maxLength": 128
    },
    "entrypoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "placement",
        "icon",
        "label",
        "order"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "maxLength": 64
        },
        "placement": {
          "enum": [
            "sidebar",
            "composer"
          ]
        },
        "icon": {
          "type": "string",
          "pattern": "^ri-[a-z0-9-]+$",
          "maxLength": 80
        },
        "label": {
          "$ref": "#/$defs/localizedText"
        },
        "order": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        }
      }
    },
    "requiredAction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action_id",
        "version_range"
      ],
      "properties": {
        "action_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
          "maxLength": 128
        },
        "version_range": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        }
      }
    }
  }
}
