{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chatraw.local/contracts/module-conformance-fixture-v1.schema.json",
  "title": "ChatRaw Module Protocol v1 Conformance Fixture",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "cases"],
  "properties": {
    "schema_version": {"const": "1"},
    "cases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "action_id",
          "input",
          "control",
          "expected_terminal_state",
          "expected_events"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,63}$"
          },
          "action_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "input": {"type": "object"},
          "control": {
            "enum": ["none", "cancel", "approve", "deny"]
          },
          "expected_terminal_state": {
            "enum": ["succeeded", "failed", "cancelled"]
          },
          "expected_events": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "task.status",
                "task.progress",
                "output.delta",
                "output.snapshot",
                "approval.requested",
                "approval.resolved",
                "artifact.added",
                "task.terminal"
              ]
            }
          },
          "expect_artifact": {
            "type": "boolean",
            "default": false
          },
          "expect_resource": {
            "type": "boolean",
            "default": false
          },
          "host_capabilities": {
            "type": "array",
            "maxItems": 4,
            "uniqueItems": true,
            "items": {
              "enum": [
                "chat.read",
                "resource.read",
                "resource.stream",
                "model.invoke",
                "model.invoke.v2"
              ]
            },
            "default": []
          },
          "timeout_seconds": {
            "type": "integer",
            "minimum": 1,
            "maximum": 120,
            "default": 30
          }
        }
      }
    }
  }
}
